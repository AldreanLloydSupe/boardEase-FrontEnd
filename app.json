{
  "expo": {
    "name": "BoardEase",
    "slug": "BoardEase",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/boardease-splash.png",
    "scheme": "boardease",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2864e8",
        "foregroundImage": "./assets/images/boardease-splash.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/boardease-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2864e8",
          "dark": {
            "image": "./assets/images/boardease-splash.png",
            "backgroundColor": "#2864e8"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow BoardEase to access your photos so you can attach payment receipts."
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BoardEase to access your camera to scan QR codes for payments."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
